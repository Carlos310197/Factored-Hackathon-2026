#!/usr/bin/env bash
# Print the web app's stable HTTPS URL (CloudFront in front of the ALB).
set -euo pipefail
export AWS_PROFILE="${AWS_PROFILE:-hackathon-sso}" AWS_REGION=us-east-1
dns=$(aws cloudfront list-distributions --query "DistributionList.Items[?Comment=='latam-bank web (HTTPS in front of the ALB)'].DomainName | [0]" --output text)
echo "https://$dns"
