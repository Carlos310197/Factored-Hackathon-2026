#!/usr/bin/env bash
# Print the web app's stable URL (the public ALB in front of the ECS service).
set -euo pipefail
export AWS_PROFILE="${AWS_PROFILE:-hackathon-sso}" AWS_REGION=us-east-1
dns=$(aws elbv2 describe-load-balancers --names latam-bank-web --query 'LoadBalancers[0].DNSName' --output text)
echo "http://$dns"
