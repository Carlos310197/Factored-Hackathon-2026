# Identity service (mock OIDC, labeled test identities)
IDP_URL=http://localhost:8081
IDP_ISSUER=http://localhost:8081
IDP_AUDIENCE=bankagent
STAFF_AUDIENCE=bankagent-staff
# AgentCore runtime invocation URL (local: the agent container)
AGENTCORE_INVOKE_URL=http://localhost:8080/invocations
# DynamoDB (local: DynamoDB Local from agent/docker-compose.yml)
AWS_REGION=us-east-1
TABLE_PREFIX=bankagent-dev
DYNAMODB_ENDPOINT=http://localhost:8000
# Realtime (empty = HTTP polling every 3 s)
NEXT_PUBLIC_EVENTS_HTTP_DOMAIN=
NEXT_PUBLIC_EVENTS_REGION=us-east-1
# 1 = /demo, demo-user picker and debug-claims enabled
DEMO_MODE=1
# 1 = POST /api/chat returns 202 and the reply arrives by push/poll
CHAT_ASYNC=0
# Session cookies are Secure in production; set 0 when serving plain HTTP (ECS public IP, no ALB)
COOKIE_SECURE=
